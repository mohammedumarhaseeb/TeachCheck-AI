# Node.js Server Port
PORT=3000
NODE_ENV=production

# Python Multimedia Processing Microservice URL (FastAPI)
PYTHON_PROCESSOR_URL=http://127.0.0.1:8000

# Server-to-Server Authentication Secret (Must match python-processor/.env)
INTERNAL_AUTH_SECRET=tc_internal_secret_change_in_production_12345

# Google Gemini API Key with Gemma 4 access
# Server-side ONLY. Never exposed to browser or committed to Git.
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

